// Configurazione per il deploy su Cloudflare Workers (solo file statici, nessun codice server).
// Prima del deploy serve la build: `npm run build` produce i file in dist/tokenizer-demo/browser.
{
  "name": "tokenizer-demo",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/tokenizer-demo/browser",
    "not_found_handling": "single-page-application",
  },
}
